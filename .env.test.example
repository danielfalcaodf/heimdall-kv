# .env.test.example — Variáveis necessárias para rodar os testes automatizados
# Copie para .env.test e defina valores que atendam à política de senha V1:
#   - mínimo 12 caracteres
#   - pelo menos 1 letra maiúscula, 1 minúscula e 1 dígito
# Nunca use estas senhas em ambientes reais.

# Senha principal usada nos testes (convite, login, sessão)
TEST_PASSWORD=

# Senha alternativa usada para testar rejeição de reutilização de convite
TEST_PASSWORD_ALT=

# Senha errada usada para testar falha de login
TEST_PASSWORD_WRONG=
