# .env.example — API (NestJS)
# Copie para .env e preencha os valores reais (nunca versionar .env)

# Servidor
PORT=3001
NODE_ENV=development

# Banco de dados (PostgreSQL)
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=heimdall_kv
DATABASE_USER=postgres
DATABASE_PASSWORD=TROQUE_AQUI

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT (gere uma chave segura)
JWT_SECRET=TROQUE_POR_CHAVE_SEGURA
JWT_EXPIRES_IN=7d
