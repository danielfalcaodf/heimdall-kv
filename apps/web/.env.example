# .env.example — Web (Next.js)
# As variáveis principais estão centralizadas na raiz do monorepo.
# Copie o .env.example da raiz: cp .env.example .env
#
# Para Next.js, crie também apps/web/.env.local com as vars NEXT_PUBLIC_* se necessário.

NEXT_PUBLIC_API_URL=http://localhost:3001/api
NEXT_PUBLIC_DEMO_ROLE=administrator
