# .env.example — Worker (NestJS)
# Copie para .env e preencha os valores reais (nunca versionar .env)

# Servidor
PORT=3002
NODE_ENV=development

# Banco de dados (PostgreSQL)
DATABASE_URL=postgresql://heimdall_user:TROQUE_AQUI@localhost:5432/heimdall_kv?schema=public

# Redis / BullMQ
REDIS_HOST=localhost
REDIS_PORT=6379
HEALTH_QUEUE_NAME=system.health.sanity

# Storage privado local ou S3-compatible via adapter futuro
STORAGE_PRIVATE_ROOT=.local/storage/private
