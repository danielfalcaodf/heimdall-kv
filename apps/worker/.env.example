# .env.example — Worker (NestJS)
# Copie para .env e preencha os valores reais (nunca versionar .env)

# Servidor
PORT=3002
NODE_ENV=development

# Banco de dados (PostgreSQL)
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=heimdall_kv
DATABASE_USER=postgres
DATABASE_PASSWORD=TROQUE_AQUI

# Redis / BullMQ
REDIS_HOST=localhost
REDIS_PORT=6379
