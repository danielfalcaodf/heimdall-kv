# ─────────────────────────────────────────────────────────────────────────────
# .env.example — Raiz do monorepo heimdall-kv
# Copie para .env e substitua os placeholders pelos valores reais.
# NUNCA versione o .env real.
#
# Como usar:
#   cp .env.example .env
#
# O Nx carrega automaticamente este arquivo para todos os apps.
# Os apps podem sobrescrever variáveis específicas no seu próprio .env.
# ─────────────────────────────────────────────────────────────────────────────

# ─── Servidor ─────────────────────────────────────────────────────────────────
NODE_ENV=development
API_PORT=3001
WORKER_PORT=3002

# ─── PostgreSQL ───────────────────────────────────────────────────────────────
POSTGRES_USER=heimdall_user
POSTGRES_PASSWORD=TROQUE_AQUI
POSTGRES_DB=heimdall_kv
DATABASE_URL=postgresql://heimdall_user:TROQUE_AQUI@localhost:5432/heimdall_kv?schema=public

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
HEALTH_QUEUE_NAME=system.health.sanity

# ─── Storage ──────────────────────────────────────────────────────────────────
STORAGE_PRIVATE_ROOT=.local/storage/private

# ─── MinIO (Storage S3-compatible) ────────────────────────────────────────────
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=TROQUE_AQUI
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=TROQUE_AQUI
MINIO_SECRET_KEY=TROQUE_AQUI

# ─── JWT / Auth ───────────────────────────────────────────────────────────────
JWT_SECRET=TROQUE_POR_CHAVE_SEGURA_MIN_64_CHARS
JWT_EXPIRES_IN=7d

# ─── Web / Next.js ────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:3001/api
NEXT_PUBLIC_DEMO_ROLE=administrator

# ─── pgAdmin (dev-tools — apenas com docker compose --profile dev-tools) ──────
PGADMIN_DEFAULT_EMAIL=admin@local.dev
PGADMIN_DEFAULT_PASSWORD=TROQUE_AQUI
