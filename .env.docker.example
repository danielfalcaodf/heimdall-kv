# .env.docker.example — Variáveis de ambiente para rodar com docker compose
# Copie para .env e ajuste conforme necessário (nunca versionar .env)

# API
PORT=3001
NODE_ENV=development

# PostgreSQL (via docker compose)
DATABASE_URL=postgresql://heimdall_user:TROQUE_AQUI@localhost:5432/heimdall_kv?schema=public

# Redis (via docker compose)
REDIS_HOST=localhost
REDIS_PORT=6379
HEALTH_QUEUE_NAME=system.health.sanity

# Storage privado local
STORAGE_PRIVATE_ROOT=.local/storage/private

# JWT
JWT_SECRET=TROQUE_POR_CHAVE_SEGURA
JWT_EXPIRES_IN=7d

# MinIO (opcional - via docker compose)
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=TROQUE_AQUI
