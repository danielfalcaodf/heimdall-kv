# .env.docker.example — Variáveis de ambiente para rodar com docker compose
# Copie para .env e ajuste conforme necessário (nunca versionar .env)

# API
PORT=3001
NODE_ENV=development

# ─── Docker Compose — PostgreSQL ──────────────────────────────────────────────
# Usadas tanto pelo docker-compose.yml quanto pela DATABASE_URL da aplicação
POSTGRES_USER=heimdall_user
POSTGRES_PASSWORD=<senha_postgres>
POSTGRES_DB=heimdall_kv

# PostgreSQL (via docker compose)
DATABASE_URL=<url_conexao_postgres>
# Exemplo de formato: postgresql://heimdall_user:<senha_postgres>@localhost:5432/heimdall_kv?schema=public

# Redis (via docker compose)
REDIS_HOST=localhost
REDIS_PORT=6379
HEALTH_QUEUE_NAME=system.health.sanity

# Storage privado local
STORAGE_PRIVATE_ROOT=.local/storage/private

# JWT
JWT_SECRET=<jwt_secret_minimo_32_chars>
JWT_EXPIRES_IN=7d

# ─── Docker Compose — MinIO ───────────────────────────────────────────────────
MINIO_ROOT_USER=<usuario_admin_minio>
MINIO_ROOT_PASSWORD=<senha_admin_minio>

# MinIO (via docker compose) — variáveis da aplicação
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=<minio_access_key>
MINIO_SECRET_KEY=<minio_secret_key>

# ─── Docker Compose — pgAdmin (dev-tools) ────────────────────────────────────
PGADMIN_DEFAULT_EMAIL=admin@local.dev
PGADMIN_DEFAULT_PASSWORD=<senha_pgadmin_local>
